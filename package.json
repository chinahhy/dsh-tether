{
  "name": "dsh-plugin-tether",
  "version": "0.1.18",
  "description": "iOS-focused remote client bridge for DeepSeek Harness — connect an iPhone to DSH running on a Mac over encrypted iroh P2P/relay transport",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ios",
    "mobile",
    "remote",
    "p2p",
    "iroh"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chinahhy/dsh-tether.git"
  },
  "homepage": "https://github.com/chinahhy/dsh-tether",
  "bugs": {
    "url": "https://github.com/chinahhy/dsh-tether/issues"
  },
  "author": "zexadev",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.7 <0.1.1-0 || >=0.1.2-alpha.0 <0.1.3-0 || >=0.1.5-alpha.0 <0.1.8-0",
    "@deepseek-ai/dsh-user-approval": ">=0.1.0-rc.7 <0.1.1-0 || >=0.1.2-alpha.0 <0.1.3-0 || >=0.1.5-alpha.0 <0.1.8-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-approval": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "dsh-tether-host-darwin-arm64": "0.1.18",
    "dsh-tether-host-darwin-x64": "0.1.18",
    "dsh-tether-host-linux-arm64": "0.1.18",
    "dsh-tether-host-linux-x64": "0.1.18",
    "dsh-tether-host-win32-x64": "0.1.18"
  }
}
